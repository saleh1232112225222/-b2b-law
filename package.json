{
  "name": "b2b-web",
  "version": "1.0.1",
  "description": "B2B-LAW Web Application",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vue-tsc --noEmit && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "server:dev": "npm --prefix cloud-server run dev",
    "server:start": "npm --prefix cloud-server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@types/luxon": "^3.7.1",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.16.1",
    "chart.js": "^4.5.1",
    "lucide-vue-next": "^1.0.0",
    "luxon": "^3.7.2",
    "mdi": "^2.2.43",
    "pinia": "^2.3.1",
    "uuid": "^14.0.0",
    "vue": "^3.5.25",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4",
    "vuetify": "^3.7.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.1",
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.11",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  }
}
